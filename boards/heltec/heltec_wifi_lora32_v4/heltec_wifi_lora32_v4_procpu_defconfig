CONFIG_CLOCK_CONTROL=y
CONFIG_CONSOLE=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y

# The GNSS control lines (EN/STANDBY/RESET) are driven at boot with gpio-hogs
# (see the board devicetree). NOTE: the FEM pins are NOT hogged — they are owned
# by heltec_wifi_lora32_v4_fem.c, which runtime-detects GC1109 vs KCT8103L. This
# symbol is for the GNSS hogs.
CONFIG_GPIO_HOGS=y
