/*
 * Heltec WiFi LoRa 32 (V4) — hardware common to all V4 revisions.
 *
 * Pin source: the Meshtastic reference firmware
 * (firmware/variants/esp32s3/heltec_v4/variant.h). Anything that differs
 * between the 4.2 (GC1109 FEM) / 4.3 (KCT8103L FEM) / r8 (octal-PSRAM) boards
 * is NOT here — it lives in the per-board .dts or the per-revision overlay.
 *
 * Relative to the V3 the SoC and the RF path changed; the digital wiring did
 * not. The radio SPI pins (CS8/RESET12/BUSY13/DIO1-14/SCK9/MISO11/MOSI10), the
 * OLED I2C (SDA17/SCL18, RESET21), the white LED (GPIO35), the button (GPIO0)
 * and the VBAT divider are all identical to the upstream V3 board.
 *
 * NEW on V4, and the reason this is more than a config tweak:
 *
 *   RF front-end module (FEM).  The SX1262 no longer drives the antenna
 *   directly; it feeds an integrated PA+LNA FEM (GC1109 on 4.2, KCT8103L on
 *   4.3/r8).  The FEM needs three controls the bare-radio V3 never had:
 *     - VFEM power   (GPIO7, "LORA_PA_POWER")  -> LDO enable, must be ON first
 *     - CSD enable   (GPIO2)                   -> HIGH = FEM on, LOW = shutdown
 *     - mode select  (GPIO46 or GPIO5)         -> HIGH on TX, LOW on RX
 *   The SX1262's own DIO2 drives the FEM's TX/RX path-select pin automatically
 *   (dio2-tx-enable, same mechanism as V3). These other three pins are owned by
 *   the board C init (heltec_wifi_lora32_v4_fem.c): it powers the rail, detects
 *   which FEM is fitted (reads CSD), and drives the mode pin with the radio via
 *   the FEM hook (<zephyr/meshtastic/fem.h>) — HIGH on TX, LOW on RX (the RX-LOW
 *   enables the KCT8103L LNA). One image for both revisions; no gpio-hogs here.
 *
 * VERIFY(hardware): on the bench confirm (a) the OLED powers up (Vext polarity),
 * (b) the boot log names the detected FEM, and (c) TX actually engages the PA
 * (measure output power) rather than the ~1 dB bypass path.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		led0 = &led0;
		pwm-0 = &ledc0;
		pwm-led0 = &pwm_led_white;
		uart-0 = &uart0;
		uart-1 = &uart1;
		i2c-0 = &i2c0;
		lora0 = &lora0;
		sw0 = &button0;
		watchdog0 = &wdt0;
		die-temp0 = &coretemp;
		gnss = &gnss;
	};

	leds {
		compatible = "gpio-leds";

		led0: led {
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;	/* GPIO35 */
			label = "White LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led_white: pwm_led_gpio35 {
			label = "White PWM LED";
			pwms = <&ledc0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "USER Key";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/*
	 * Battery sense: plain resistor divider on GPIO1 (ADC1 ch0), same as V3.
	 * The V4 has NO fuel-gauge IC. VBAT sense is gated by ADC_CTRL (GPIO37);
	 * see adc_ctrl below.
	 */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc1 0>;
		output-ohms = <100000>;
		full-ohms = <(100000 + 390000)>;
		power-domains = <&adc_ctrl>;
	};

	/*
	 * ADC_CTRL (GPIO37) gates the battery divider on 4.2/4.3. Absent on r8
	 * (that board omits ADC_CTRL) — the r8 .dts deletes this node.
	 */
	adc_ctrl: adc_ctrl {
		compatible = "power-domain-gpio";
		enable-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;	/* GPIO37, ADC_CTRL_ENABLED=HIGH */
		#power-domain-cells = <0>;
		label = "ADC Control";
	};

	/*
	 * Console/shell on the ESP32-S3 built-in USB-Serial-JTAG (&usb_serial),
	 * NOT uart0. The V4 REMOVED the CP2102 bridge the V3 used — the USB-C port
	 * is wired to the SoC's native USB (D+/D- on GPIO19/20), so uart0
	 * (GPIO43/44) is no longer reachable over the cable. usb_serial enumerates
	 * as a CDC-ACM device (/dev/ttyACM0) and carries both the boot log and the
	 * shell. The SERIAL_ESP32_USB driver auto-enables from the node below.
	 * uart0 stays enabled for the header pins / netserial PhoneAPI.
	 */
	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,display = &ssd1306_128x64;
	};
};

/* Native USB console/shell — the V4 has no CP2102 (see chosen above). */
&usb_serial {
	status = "okay";
};

&adc1 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/*
 * GNSS is an OPTIONAL pluggable module, not soldered on the V4. The board
 * itself provides the SH1.25-8Pin GNSS connector, an enable/standby control
 * GPIO (driven by the per-board .dts — a gps_standby hog; pins move on r8),
 * and this NMEA UART. Some V4 kits include an external GPS board (typically a
 * Quectel L76K or compatible NMEA receiver) that plugs in here. The generic
 * NMEA driver handles any such receiver; with no module connected it simply
 * never reports a fix, which is harmless.
 * VERIFY(hardware): baud (L76K defaults to 9600) and that the standby/enable
 * line is asserted.
 */
&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";

	gnss: gnss {
		compatible = "gnss-nmea-generic";
		status = "okay";
	};
};

/*
 * The RF front-end module (FEM) control pins — VFEM power (GPIO7), CSD
 * chip-enable (GPIO2), and the per-FEM mode pin (GC1109 CPS = GPIO46 /
 * KCT8103L CTX = GPIO5) — are NOT hogged here. They are owned by the board C
 * init (heltec_wifi_lora32_v4_fem.c), which powers the rail, RUNTIME-DETECTS
 * which FEM is fitted by reading CSD, logs it, and configures the right pins.
 * That is why this is a single image with no board revisions. DIO2 still drives
 * the FEM TX/RX path-select pin automatically (dio2-tx-enable on lora0).
 */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	/* SSD1315 OLED — driver-compatible with the SSD1306, same as V3. */
	ssd1306_128x64: display-controller@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		inversion-on;
		prechargep = <0x22>;
		reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		power-domains = <&vext_ctrl>;
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";

	cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;

	/*
	 * SX1262 — identical digital wiring to the V3. DIO2 drives the FEM's
	 * TX/RX path-select pin (dio2-tx-enable); DIO3 supplies the 1.8 V TCXO.
	 * rx-boosted matches the reference firmware default (+3 dB RX sensitivity).
	 */
	lora0: modem@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		reset-gpios = <&gpio0 12 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
		busy-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		/*
		 * GPIO_INT_WAKEUP arms GPIO14 as a light-sleep wake source so an
		 * incoming frame (DIO1 goes HIGH on RX-done and stays HIGH until the
		 * driver clears it over SPI) wakes the SoC from PM_STATE_STANDBY instead
		 * of waiting for the next RTC-timer tick. The flag rides the sx126x
		 * driver's own gpio_pin_configure_dt(dio1, GPIO_INPUT) call at init, which
		 * on the ESP32-S3 arms EXT1 (RTC controller, level-HIGH) on GPIO14 — a
		 * valid EXT1 pin (<= GPIO21). It coexists with the driver's normal edge
		 * IRQ (separate GPIO-matrix interrupt; the esp32 gpio driver strips the
		 * WAKEUP bit from interrupt-config, so the two never clobber each other).
		 *
		 * Two consequences handled elsewhere:
		 *  - EXT1 arming is compiled in whenever CONFIG_PM *or* CONFIG_POWEROFF, so
		 *    it also arms for deep sleep. The admin shutdown path disarms it before
		 *    sys_poweroff() (meshtastic_radio_disarm_dio1_wake()), so a powered-off
		 *    node still wakes only on reset — as canShutdown advertises.
		 *  - EXT1 wakes the CPU but the edge was missed while asleep, so the frame
		 *    is not auto-read; the PM wake hook (meshtastic_radio.c) polls DIO1 on
		 *    wake and submits the driver work. See docs/light-sleep-governor.md.
		 */
		dio1-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_INT_WAKEUP)>;
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
		spi-max-frequency = <4000000>;
		rx-boosted;
	};
};

/*
 * Power management: make the board CAPABLE of light sleep.
 *
 * Zephyr's PM path for the ESP32-S3 maps PM_STATE_STANDBY -> esp_light_sleep_start()
 * (soc/espressif/common/power.c). It has a hard prerequisite that is easy to miss:
 * the SoC's RTC timer must be enabled AND marked as a wake source, otherwise
 * pm_state_set() bails out with "Sleep skipped. Make sure RTC counter driver is
 * enabled." — a log line, not a build error. The SoC dtsi ships rtc_timer as
 * status = "disabled", so every board has to opt in. Do that here.
 *
 * Everything below is INERT unless the application sets CONFIG_PM (and, for the
 * power domains above, CONFIG_PM_DEVICE): with PM off, the counter driver is not
 * built and the wakeup-source flags have no consumer. So this describes hardware
 * capability, it does not impose a power policy — the per-board profile overlays
 * (samples/meshtastic/overlay-v4-*.conf) carry the PM opt-in.
 *
 * `wakeup-source` here means exactly one thing: under CONFIG_PM_DEVICE_SYSTEM_MANAGED,
 * these devices are skipped by the suspend-everything loop, so they stay powered
 * across a system low-power state (subsys/pm/device_system_managed.c). It does NOT
 * configure a pin, an interrupt, or the SoC wake matrix — the application still has
 * to arm the actual wake source (pm_device_wakeup_enable(), and the usual GPIO
 * interrupt config for a pin wake).
 */
&rtc_timer {
	status = "okay";
	wakeup-source;
};

/*
 * gpio0 carries both wake-capable pins we care about: the USER button (GPIO0) and
 * the SX1262's DIO1 IRQ (GPIO14). Both are <= GPIO21, so both are RTC-capable and
 * inside the ESP32-S3 GPIO-wake mask (GPIO0-GPIO21). Keep the controller powered
 * across sleep or neither can wake us.
 */
&gpio0 {
	wakeup-source;
};

/*
 * Keep the radio powered across light sleep. A mesh node that suspends its
 * transceiver on every idle window stops hearing the mesh; the reference firmware
 * makes the same choice (its LS state keeps LoRa on and only deep sleep powers the
 * radio down). Note the Zephyr sx126x PM action only disconnects/reconnects the RF
 * switch GPIOs — chip sleep is driven separately by the driver's own idle handling.
 */
&lora0 {
	wakeup-source;
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&timer3 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
