# Heltec Vision Master E290 (HT-VME290) board configuration
#
# SPDX-License-Identifier: Apache-2.0

config BOARD_HELTEC_VISION_MASTER_E290
	# ESP32-S3R8 WROOM: 8MB flash + 8MB OCTAL PSRAM.
	# (Meshtastic treats this board as 8MB flash — see the board .dts note.)
	select SOC_ESP32S3_WROOM_N8R8
	select SOC_ESP32S3_PROCPU if BOARD_HELTEC_VISION_MASTER_E290_ESP32S3_PROCPU
	select SOC_ESP32S3_APPCPU if BOARD_HELTEC_VISION_MASTER_E290_ESP32S3_APPCPU
