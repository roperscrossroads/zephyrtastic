# SPDX-License-Identifier: Apache-2.0

if BOARD_HELTEC_VISION_MASTER_E290_ESP32S3_PROCPU

# Vext (e-ink power) and ADC_CTRL (battery divider) are GPIO power-domains,
# same model as the V3/V4. Enable the machinery so the panel's power-domains
# phandle actually gates GPIO18 and the divider gate GPIO46 at init — this is
# what powers the display at boot without an application write.
config POWER_DOMAIN
	default y

config POWER_DOMAIN_GPIO
	default y

# Monochrome e-ink: if the app uses LVGL, drive it 1-bpp with the mono
# inversion the SSD1680 panels want. Inert when LVGL is off.
if LVGL

config LV_Z_VDB_SIZE
	default 64

config LV_Z_COLOR_MONO_HW_INVERSION
	default y

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # BOARD_HELTEC_VISION_MASTER_E290_ESP32S3_PROCPU
