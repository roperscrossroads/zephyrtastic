menuconfig MESHTASTIC_POSITION
	bool "Meshtastic position service"
	default y
	help
	  Position portnum module: caches the node's position (from a GNSS
	  source and/or an admin-set fixed position), answers incoming Position
	  requests, and broadcasts. Required by MESHTASTIC_GNSS, which is just
	  one optional source feeding it; can also run stand-alone on a GNSS-less
	  node to advertise a fixed position (admin set_fixed_position).

if MESHTASTIC_POSITION

config MESHTASTIC_POSITION_BROADCAST_INTERVAL_SEC
	int "Default position broadcast interval in seconds"
	default 300 if MESHTASTIC_GNSS
	default 900
	range 5 86400
	help
	  The compiled default for PositionConfig.position_broadcast_secs: a
	  stored nonzero value overrides it, read afresh at every broadcast, so
	  an admin/shell write applies to the next one with no reboot
	  (agents-t2hb.2). Governs both senders -- the GNSS fix-driven gate and
	  the timer that re-announces a fixed or phone-supplied position. The
	  two defaults preserve what each build shape did before the two
	  intervals were merged (GNSS 300 s, fixed-position beacon 900 s).

config MESHTASTIC_POSITION_STATIONARY_FLOOR_SEC
	int "Minimum broadcast interval while stationary, in seconds"
	default 21600
	range 0 604800
	help
	  The reference's default_position_stationary_broadcast_secs (6 h):
	  while the node is stationary -- a fixed position, or still in the
	  precision cell of its last broadcast -- the periodic broadcast is held
	  to at least this. A real move still goes out early through smart
	  broadcast. LOST_AND_FOUND is exempt. It is 1 h longer than the
	  traffic module's 5 h position dedup window on purpose, so a
	  neighbour does not dedup the refresh away (agents-t2hb.3). 0 disables
	  the floor.

config MESHTASTIC_POSITION_TO_PHONE
	bool "Push our own position to a connected phone periodically"
	default y
	depends on MESHTASTIC_PHONEAPI
	help
	  The reference's sendOurPositionToPhone (POS-5): our position, at full
	  precision, handed to the phone every MESHTASTIC_POSITION_TO_PHONE_SEC --
	  never to the mesh, so it costs no airtime and ignores channel sharing
	  (mesh sharing is opt-in in 2.8; the local view should not go dark
	  because of it). Same path as the LocalStats and DeviceMetrics pushes.

config MESHTASTIC_POSITION_TO_PHONE_SEC
	int "Own-position to-phone interval in seconds"
	default 60
	range 10 3600
	depends on MESHTASTIC_POSITION_TO_PHONE
	help
	  The reference's sendToPhoneIntervalMs (60 s).

config MESHTASTIC_POSITION_REPLY_SUPPRESS_SEC
	int "Minimum seconds between Position want_response replies"
	default 180
	range 0 86400
	help
	  Rate-limit responses to incoming Position requests with want_response
	  set, matching stock PositionModule behavior.

endif # MESHTASTIC_POSITION
