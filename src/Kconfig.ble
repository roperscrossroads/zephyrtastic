menuconfig MESHTASTIC_BLE
	bool "Meshtastic Bluetooth PhoneAPI service"
	depends on BT && BT_PERIPHERAL
	select MESHTASTIC_PHONEAPI
	help
	  Expose the Meshtastic Bluetooth GATT service with toRadio,
	  fromRadio, fromNum, and logRadio characteristics.

if MESHTASTIC_BLE

config MESHTASTIC_BLE_PAIRING
	bool "Support phone pairing and bonding"
	default y
	select BT_SMP
	select BT_SMP_APP_PAIRING_ACCEPT
	help
	  Enable Bluetooth SMP so mobile apps that initiate bonding can pair
	  with the Meshtastic BLE service instead of failing with pairing not
	  supported.

config MESHTASTIC_BLE_FIXED_PASSKEY
	bool "Use a fixed passkey for Meshtastic app pairing"
	default n
	depends on MESHTASTIC_BLE_PAIRING
	select BT_APP_PASSKEY
	select BT_SMP_ENFORCE_MITM
	help
	  When enabled, use MITM-protected Secure Connections pairing with a
	  six-digit passkey (default 123456) and report FIXED_PIN to phone
	  clients. When disabled (default), pairing uses Just Works with no
	  passkey and phone clients receive NO_PIN in the Bluetooth config.

config MESHTASTIC_BLE_PASSKEY
	int "Bluetooth pairing passkey"
	default 123456
	range 0 999999
	depends on MESHTASTIC_BLE_FIXED_PASSKEY
	help
	  Passkey entered in the Meshtastic mobile app during pairing. Matches
	  the official firmware fixed_pin default.

	  This is only the value meshtastic_config_store_seed() writes into
	  SecurityConfig.bluetooth.fixed_pin on first boot -- the node then
	  pairs on whatever that runtime config field holds, which the phone
	  app's "set Bluetooth PIN" (or the equivalent admin write) can change
	  without a reflash (agents-ooma.33). A leaked or shoulder-surfed PIN
	  is rotated by writing the config, not by rebuilding.

config MESHTASTIC_BLE_ADV
	bool "Start Meshtastic BLE advertising from meshtastic_init"
	default y
	help
	  Start connectable advertising for the Meshtastic service after the
	  Bluetooth stack is enabled.

config MESHTASTIC_BLE_NAME_PREFIX
	string "Prefix for the composed Bluetooth advertising name"
	default "zeph-"
	help
	  The advertised name is composed at advert time as
	  <prefix><owner short name> — e.g. "zeph-rzr3".

	  It used to be one compile-time constant, which meant every node built
	  from this tree advertised the SAME name and a phone could not tell two
	  bench boards apart. The short name is the node's identity everywhere
	  else, so the advert carries it too.

	  A node whose short name is unset falls back to <prefix><node id
	  suffix>, NOT to a shared constant: an unnamed node is exactly the case
	  that used to collide, so the fallback has to stay unique.

config MESHTASTIC_BLE_FROMRADIO_QUEUE_SIZE
	int "FromRadio queue depth"
	default 8
	range 8 64
	help
	  Number of encoded FromRadio frames retained for Bluetooth clients.

config MESHTASTIC_BLE_WORK_STACK_SIZE
	int "Bluetooth PhoneAPI work thread stack size"
	default 6144
	help
	  Stack size for deferred ToRadio/FromRadio protobuf handling. Config
	  sync builds large FromRadio messages and must not run on the small
	  Bluetooth host workqueue stack.

config MESHTASTIC_BLE_WORK_PRIORITY
	int "Bluetooth PhoneAPI work thread priority"
	default 8
	help
	  Priority for deferred ToRadio command handling.

menuconfig MESHTASTIC_BLE_PEER
	bool "Node-to-node BLE peer link (experimental)"
	default n
	select BT_CENTRAL
	select BT_GATT_CLIENT
	# Scan on the identity address, not an NRPA: with legacy advertising the
	# scanner and the advertiser share ONE random-address register, and the
	# host's NRPA default made a scan-while-advertising ask for an address
	# that was never written on a public identity (ESP32: HCI 0x200c status
	# 0x12, agents-f5f2), or collide with the advert on a random one (nRF).
	# The scan is passive, so it never transmits the identity it carries.
	imply BT_SCAN_WITH_IDENTITY
	help
	  Expose this port's own peer GATT service (deliberately separate from
	  the Meshtastic phone service, with its own UUID namespace) carrying a
	  16-byte heartbeat, add the node number to the advertisement as
	  manufacturer-specific data, and enable the passive peer scanner and
	  central role so this node can find and connect to other peers. BLE
	  range sits entirely inside LoRa range, so this never extends reach —
	  it is a fast local pipe between co-located nodes.

	  Requires CONFIG_BT_MAX_CONN >= 2 (build-asserted) so a phone and a
	  peer can be connected at once. A phone-only build (this symbol off)
	  keeps today's advertisement byte-identical and classifies incoming
	  connections as the phone instantly, exactly as before.

if MESHTASTIC_BLE_PEER

config MESHTASTIC_BLE_PEER_CLASSIFY_WINDOW_MS
	int "Incoming-connection classify window (ms)"
	default 3000
	help
	  An incoming connection is ambiguous (an incoming peer central and a
	  phone both arrive in the peripheral role). It is classified by
	  evidence — PhoneAPI traffic makes it the phone, a valid peer beat
	  makes it a peer — and after this window with no evidence it defaults
	  to the phone. Phones normally produce traffic within a second of
	  connecting, so the default only decides genuinely idle links.

config MESHTASTIC_BLE_PEER_BEAT_PERIOD_MS
	int "Heartbeat period (ms)"
	default 1000
	help
	  How often the beat engine sends on each active peer link (notify
	  toward a subscribed central, write toward a connected peripheral).

config MESHTASTIC_BLE_PEER_STICKY_MS
	int "Prefer the last-linked courier for this long on a bare rescan (ms)"
	default 60000
	depends on MESHTASTIC_BLE_PEER
	help
	  A central with no targeted intent (`blepeer scan on`) remembers the
	  peer its last outbound link was to and, when it looks again, passes
	  over other peers' adverts for this long before admitting anyone. A
	  kit that swapped and rebooted re-forms toward its courier instead of
	  whichever peer advertises first (a two-kit star made that grab likely,
	  2026-08-28). Longer than a courier's own reboot: at 20 s a kit whose
	  courier was mid-swap (~30 s) fell back to the other kit and then
	  REMEMBERED it. 0 disables the preference.

config MESHTASTIC_BLE_PEER_FRAME_CONN_INTERVAL_MS
	int "Connection interval the central asks for once its frame channel is up (ms, 0 = keep the default)"
	default 0
	range 0 4000
	help
	  The peer central dials with the host's default connection parameters
	  (a 30-50 ms interval) and nothing on the link ever renegotiates them
	  (peripherals run with BT_GAP_AUTO_UPDATE_CONN_PARAMS=n). A frame's
	  delivery waits for a connection event, so the interval is the floor of
	  the link's latency -- measured 2026-09-28 (ATTACHMENT-STATUS §2c). A
	  role that needs frames fast (a radio head feeding its brain, whose
	  relay timing runs on that latency) sets this; the interval is a
	  link-role fact, so a plain peer keeps the default and its power. The
	  request is central-initiated (the direction the 2026-08-26 stability
	  note allows); the peripheral's controller may still refuse it, and the
	  live interval is logged at frame-ready either way. Rounded down to
	  1.25 ms units; below 7.5 ms is clamped to 7.5.

config MESHTASTIC_BLE_PEER_BRINGUP_TIMEOUT_MS
	int "Outbound link bring-up budget (ms)"
	default 10000
	range 1000 120000
	help
	  An outbound peer link that has connected but not finished discovery
	  and subscribe within this long is disconnected and the hunt resumes.
	  Without a bound, a peer that connected and then never answered (or
	  answered without the peer service) held the one outbound slot
	  forever, blocking every rescan.

config MESHTASTIC_BLE_PEER_SEEN_MAX
	int "Peer advert table size"
	default 8
	help
	  How many distinct advertising peers the passive scanner remembers
	  for `meshtastic blepeer list`.

endif # MESHTASTIC_BLE_PEER

endif # MESHTASTIC_BLE
