# SPDX-License-Identifier: GPL-3.0

menuconfig MESHTASTIC_SCANNER
	bool "Multi-preset RX-only survey (scanner)"
	default n
	help
	  Cycle the radio across the region's presets and log the plaintext header
	  of every frame heard, from any mesh, with no keys and no channel setup.
	  Answers "which presets are actually in use around me" — information no
	  ordinary node can gather, since each one only ever sees its own preset.

	  Safe to enable in an ordinary node build: scanning is a RUNTIME mode
	  (`meshtastic scan start` / `stop`), and while it is active every transmit
	  is refused at the single choke point every TX already funnels through.
	  The node stops participating for the duration and resumes afterwards.

	  See docs/MULTI-PRESET-OPERATION.md §3.

if MESHTASTIC_SCANNER

config MESHTASTIC_SCANNER_RX_ONLY
	bool "Dedicated scanner: compile the transmit path out entirely"
	default n
	help
	  For a build that will ONLY ever scan. Removes the transmit path at
	  compile time, so the image is structurally incapable of transmitting.

	  This is not normally needed. Every transmission in the firmware funnels
	  through exactly one function — meshtastic_radio_send_wire_now(), whose
	  sole caller is the outbound queue drain — and the runtime gate sits
	  there, so it covers relay, NodeInfo, position, telemetry, reliable
	  retransmits, admin replies and phone-injected sends alike. There is no
	  second path to the radio to slip through.

	  The runtime gate is also the more testable of the two: it COUNTS refused
	  transmissions (see `meshtastic scan status`), so "nothing tried to
	  transmit while scanning" becomes an assertion rather than an assumption.
	  A compiled-out path cannot tell you that.

	  Say y only for a permanently-dedicated scanner node.

config MESHTASTIC_SCANNER_RING_RECORDS
	int "Retained records"
	default 2048
	range 64 262144
	help
	  Ring capacity in records (25 bytes each). The default is deliberately
	  modest so the feature fits on a board with no PSRAM at all.

	  Measured ceilings on the R8 (8 MB octal PSRAM), both verified to build:
	    v4-unified profile   100000 records (2.8 MB)  ~1.4 MB still spare
	    bare samples build   150000 records (4.2 MB)  ~126 KB spare

	  The budget is CONFIG_ESP_SPIRAM_SIZE minus the 4 MB shared-multi-heap
	  pool minus the existing ~56 KB of .ext_ram.bss statics. Note the linker
	  ASSERT that guards this ("External SPIRAM overflowed", esp32s3/default.ld)
	  measures .ext_ram.data ONLY -- .ext_ram.dummy is address-window
	  reservation for flash rodata, not PSRAM capacity, so a build whose
	  ext_dram_seg total exceeds 8 MB can still be entirely legal.

	  Oldest records are overwritten first. meshtastic_scanner_total() keeps
	  counting past the ring, so a rate estimate stays correct even once
	  records have been dropped.

config MESHTASTIC_SCANNER_DWELL_MS
	int "Dwell constant c, in milliseconds"
	default 10000
	range 1000 120000
	help
	  Each preset is visited for (its max time-on-air + c). Adding the ToA is
	  what equalises capture probability across presets: a packet is only heard
	  if its preamble starts while already listening, so a fixed dwell would
	  give slow presets a much lower chance — LongSlow's 9.28 s max packet
	  cannot be caught at all by a 5 s dwell. With D_i = ToA_i + c the capture
	  probability is c/T on every preset, which is what makes the observed
	  rates comparable.

	  c=10000 gives a ~120 s sweep at ~8.3 % uniform capture.

config MESHTASTIC_SCANNER_AUTOSTART
	bool "Start sweeping at boot"
	default n
	help
	  Otherwise the sweep is started explicitly (shell, or scanner_start()).

config MESHTASTIC_SCANNER_AUTOSTART_PRESET
	int "Preset to park on at autostart (-1 = sweep them all)"
	default -1
	range -1 15
	depends on MESHTASTIC_SCANNER_AUTOSTART
	help
	  A meshtastic_Config_LoRaConfig_ModemPreset value (e.g. 8 = ShortTurbo).

	  The runtime preset list (`meshtastic scan presets ...`) is RAM-only, so
	  without this an autostarting node comes back SWEEPING ALL PRESETS after
	  every reset — which is the right behaviour for a survey and the wrong one
	  for a tap. A dedicated listener is measuring one preset continuously, and
	  after a power cut it must resume measuring THAT one rather than quietly
	  start cycling; a gap in the record is recoverable, silently measuring the
	  wrong thing is not.

	  Narrowing to a single preset also engages tap mode: the sweep thread stops
	  re-tuning the radio at the end of each dwell, so there is no periodic blind
	  spot punched through the capture.

	  -1 keeps the old behaviour (the full sweep).

config MESHTASTIC_SCANNER_STACK_SIZE
	int "Sweep thread stack"
	default 1536

config MESHTASTIC_SCANNER_PRIORITY
	int "Sweep thread priority"
	default 10

endif # MESHTASTIC_SCANNER
