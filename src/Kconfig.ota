config MESHTASTIC_OTA
	bool "Firmware update into the MCUboot second slot over SMP (mcumgr)"
	depends on BOOTLOADER_MCUBOOT
	select MCUMGR
	select NET_BUF          # mcumgr core dependency
	select ZCBOR            # mcumgr core dependency
	select CRC              # SMP framing checksum
	select MCUMGR_GRP_IMG
	select MCUMGR_GRP_OS
	select IMG_MANAGER
	select STREAM_FLASH
	help
	  Run an mcumgr SMP server so the node can be updated into the MCUboot
	  slot1 partition (image upload -> test -> reset -> swap -> confirm), with
	  automatic MCUboot revert if a swapped image is never confirmed. Requires
	  the MCUboot A/B build (sysbuild).

	  This symbol is the SUBSYSTEM only — it deliberately selects no transport.
	  The transport is chosen by the overlay that enables it, because it is the
	  only part of the update path that depends on what radio a board has:
	    overlay-ota.conf        SMP over UDP (WiFi boards; the net profiles)
	    overlay-ota-shell.conf  SMP over the shell's serial console (any board
	                            with a console; the XIAO's USB CDC)
	  A BLE transport (MCUMGR_TRANSPORT_BT) goes beside them. The transports
	  self-start, so no application code is required for the core update path.

if MESHTASTIC_OTA

config MESHTASTIC_OTA_AUTOCONFIRM
	bool "Auto-confirm the running image after a healthy delay"
	default n
	help
	  After MESHTASTIC_OTA_CONFIRM_DELAY_SEC of healthy uptime, call
	  boot_write_img_confirmed() so a freshly-swapped image becomes permanent
	  without a manual `mcumgr image confirm`. Leave OFF for the safest story:
	  an unconfirmed image is reverted by MCUboot on the next unexpected reset.

config MESHTASTIC_OTA_CONFIRM_DELAY_SEC
	int "Auto-confirm delay (seconds)"
	default 120
	depends on MESHTASTIC_OTA_AUTOCONFIRM

endif # MESHTASTIC_OTA
