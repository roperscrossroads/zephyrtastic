# SPDX-License-Identifier: GPL-3.0

config MESHTASTIC_LOGRING
	bool "Keep the last few KB of log in RTC memory across a reset"
	default y
	select LOG_OUTPUT
	select LOG_BACKEND_SUPPORTS_FORMAT_TIMESTAMP
	help
	  Registers a log backend that mirrors the log stream into a byte ring in
	  RTC-persistent memory, and dumps whatever was there from before the last
	  reset on the next boot.

	  Added 2026-08-11. Every other diagnostic here depends on the network:
	  log_backend_net is the only backend on the shipping profile, so a node
	  that loses WiFi is silent by construction, and -- worse -- that backend
	  unconditionally no-ops once LOG_PANIC() runs, which is exactly when the
	  output matters. The crash breadcrumbs exist because of that gap, but a
	  breadcrumb says what state the node was in, not what it was doing. This
	  keeps the actual last log lines.

	  Survives every warm reset (watchdog stage 0/1, software reboot, fatal
	  error) -- which is every failure class the bench has seen. A true power
	  cycle clears RTC memory; the magic check then starts fresh rather than
	  printing garbage.

	  Deliberately NOT flash-backed: an ESP32 flash write disables the
	  instruction cache and blocks non-IRAM ISRs, which is the same
	  interrupt-masking mechanism currently suspected in the 2026-08-11
	  all-three-nodes stall. RTC memory is plain stores.

if MESHTASTIC_LOGRING

config MESHTASTIC_LOGRING_SIZE
	int "Ring size in bytes (RTC memory)"
	default 4096
	range 512 8192
	help
	  Lives in .rtc_noinit, i.e. the 8 KB rtc_slow_seg, which was 2.88% used
	  before this. 4 KB is roughly 30-50 formatted lines -- enough to cover
	  the seconds before a stall without crowding the existing RTC-persistent
	  crash breadcrumbs and reset-cause history that share the segment.

	  NOTE: an equal-sized buffer is also allocated in DRAM, to snapshot the
	  ring at boot before this boot's own logging overwrites it. Budget 2x
	  this value.

config MESHTASTIC_LOGRING_LINE_MAX
	int "Formatting buffer for one log line"
	default 128
	range 64 256
	help
	  Bounds the memcpy done under irq_lock. Longer lines are written in
	  several chunks; only their tail survives if a line exceeds the ring.

config MESHTASTIC_LOGRING_LOG_LEVEL
	int "Log level for the ring module itself"
	default 3
	range 0 4

endif # MESHTASTIC_LOGRING

config MESHTASTIC_LOGRING_FILTER
	bool "Keep per-packet chatter out of the retained ring"
	default y
	help
	  Restrict a curated list of high-volume modules to WRN-or-worse ON THE
	  RING BACKEND ONLY. The console keeps every line; what changes is how far
	  back the ring reaches after a reset.

	  This is the lever that matters, because ring SIZE barely moves. The ring
	  lives in RTC retained memory, which is 8 KB total on the ESP32-S3 and
	  already holds the boot log, the fatal breadcrumb, the watchdog crash info
	  and the persisted clock. Measured 2026-08-30: 4476 B used, so the ring
	  could reach about 7.8 KB and no further -- under 2x. Filtering is not
	  bounded that way.

	  The numbers that motivated the list, from a real 5-hour run (~25,000
	  lines, coredump excluded):

	    powermon: state=            9801   40%   one line per TX/RX transition
	    meshtastic: RX from         4885   20%
	    phone queue full (WRN)      4619   19%   see meshtastic_phoneapi.c
	    Watchdog: system heap       3121   13%
	    thread_summary              ~2600  10%

	  At that verbosity the whole 4 KB ring held about THREE MINUTES. The
	  thread summary runs every 300 s, so the one periodic health record most
	  worth having after a crash could miss the ring entirely.

	  What is deliberately NOT restricted, because it is the narrative you
	  actually read after a reset: `meshtastic` (RX/TX, heartbeat),
	  `meshtastic_sample` (boot cause + crash breadcrumbs), `thread_summary`,
	  and `os` (fault output).

	  Applied lazily on the ring backend's FIRST process() call rather than at
	  init. Before the logging thread's first tick every backend id still reads
	  0, so log_filter_set() would silently write into whatever backend holds
	  slot 0 -- the trap documented at length in meshtastic_netlog_filter.c,
	  which had to hook a network event to dodge it. Owning this backend means
	  the first process() call is a guarantee that ids are real, with no timing
	  guesswork at all.
