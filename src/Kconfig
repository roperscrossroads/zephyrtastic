menu "LoRa transmit retry"

config MESHTASTIC_TX_BUSY_RETRIES
	int "Retries when CAD reports busy channel"
	range 0 32
	default 6
	help
	  Number of retransmission attempts when lora_send() returns -EBUSY
	  because CAD/LBT detected channel activity.

config MESHTASTIC_TX_BUSY_BACKOFF_MIN_MS
	int "Minimum backoff on busy channel (ms)"
	range 0 60000
	default 8
	help
	  Minimum randomized wait in milliseconds between retry attempts when
	  the channel is busy.

config MESHTASTIC_TX_BUSY_BACKOFF_MAX_MS
	int "Maximum backoff on busy channel (ms)"
	range 0 60000
	default 40
	help
	  Maximum randomized wait in milliseconds between retry attempts when
	  the channel is busy.
	  If this is less than the minimum, the minimum value is used.

endmenu

menu "SX126x AGC reset"

config MESHTASTIC_AGC_RESET_INTERVAL_MS
	int "Periodic AGC reset interval (ms)"
	depends on LORA_SX126X
	range 1000 3600000
	default 60000
	help
	  Interval between periodic radio AGC resets (a warm-sleep power-cycle
	  of the analog frontend + RX sensitivity register patch). Matches
	  upstream Meshtastic's AGC_RESET_INTERVAL_MS: the SX126x's internal
	  AGC can get stuck and RX sensitivity silently degrades without this,
	  and does not recover on its own until reboot.

endmenu

endif # MESHTASTIC
