menuconfig MESHTASTIC_GNSS
	bool "Meshtastic GNSS position service"
	depends on GNSS
	select MESHTASTIC_POSITION
	help
	  Subscribe to Zephyr GNSS data and feed Meshtastic Position payloads to
	  the position module (MESHTASTIC_POSITION), which owns the portnum
	  handling, replies, and transmission.

if MESHTASTIC_GNSS

config MESHTASTIC_GNSS_AUTO_SEND
	bool "Automatically send GNSS fixes"
	default y
	help
	  Send a Position payload whenever a valid GNSS fix is published and
	  the configured interval has elapsed.

config MESHTASTIC_GNSS_SEND_INTERVAL_SEC
	int "GNSS position send interval in seconds"
	default 300
	range 5 86400
	help
	  Minimum interval between successful automatic Position packets.

config MESHTASTIC_GNSS_RETRY_INTERVAL_SEC
	int "Minimum seconds between failed position send attempts"
	default 60
	range 5 3600
	help
	  After a failed automatic position transmission, wait at least this
	  long before trying again. Prevents hammering the radio when the GNSS
	  driver publishes fixes frequently.

if MESHTASTIC_GNSS_AUTO_SEND

config MESHTASTIC_GNSS_SEND_WORK_STACK_SIZE
	int "GNSS position send workqueue stack size"
	default 4096
	help
	  Stack for the dedicated workqueue that sends Position packets
	  (nanopb encoding and PSA AES-CTR on a full payload buffer, then the
	  whole egress path: airtime gate, contention plan, outbound enqueue).

	  Was 2048 until 2026-09-02, and that overflowed on the bench: rzr2, a
	  class-4 V4 member at a window, crash-looped every ~85 s -- an illegal
	  instruction with SP 192 bytes below this stack's base -- the moment its
	  first GNSS fix seeded the clock and this queue sent the first position.
	  The overrun corrupts whatever the linker placed directly below the
	  stack, which is why the fault was an illegal instruction in an
	  "unknown" thread rather than a clean stack-check failure. Measure
	  before lowering it (thread analyzer, TA=1).

config MESHTASTIC_GNSS_SEND_WORK_PRIORITY
	int "GNSS position send workqueue priority"
	default 8
	help
	  Priority for deferred GNSS position transmissions.

endif # MESHTASTIC_GNSS_AUTO_SEND

config MESHTASTIC_GNSS_TIME_DEBUG
	bool "Log GNSS time-delivery diagnostics (bench only)"
	default n
	help
	  Log one line per GNSS data callback, stamped with k_cycle_get_32() and
	  k_uptime_get() taken at the very top of the callback — BEFORE the no-fix
	  gate, so a module that is tracking satellites but has not yet fixed is
	  still visible.

	  This measures the term that actually bounds GNSS time accuracy, which is
	  not sub-second resolution but one-sided LATENCY: the delay from the true
	  UTC second to the moment we are handed the sentence. That delay is the
	  receiver's own fix latency plus the whole sentence's UART time (~73 ms for
	  a 70-character RMC at 9600 baud, because modem_chat only delivers on a
	  complete match). It is a late bias of order 100-500 ms, not a symmetric
	  quantisation, so it cannot be averaged away.

	  The cycle stamp shares a counter with the board-level `gps pps` edge
	  capture, so an interleaved console capture yields the latency directly by
	  subtraction. Without a PPS reference the same log still yields the
	  inter-callback jitter and the reported sub-second digits.

	  Bench diagnostic. Off in shipping images: it logs at up to the GNSS
	  publish rate.

config MESHTASTIC_GNSS_PPS
	bool "Capture the GNSS 1PPS edge"
	default y
	depends on DT_HAS_MESHTASTIC_GNSS_PPS_ENABLED && GPIO
	help
	  Timestamp the rising edge of the receiver's pulse-per-second output, from
	  the pin described by the board's meshtastic,gnss-pps node.

	  The edge is the only microsecond-grade time reference on the board. The
	  NMEA sentence naming the same second arrives ~853 ms later (measured on
	  an L76K at 9600 baud): the receiver's fix latency plus the whole
	  sentence's UART time, since the modem layer only delivers on a complete
	  match. That delay is one-sided, so it cannot be averaged away — it is a
	  bias, not noise.

	  Armed at init rather than on demand, because this is a time source and
	  not a diagnostic: a receiver needs sky, and a node at a window is on
	  battery with nobody typing at it. Compiled out on boards whose
	  devicetree describes no such pin.

config MESHTASTIC_GNSS_PPS_LOG_EDGES
	bool "Log one line per 1PPS edge"
	depends on MESHTASTIC_GNSS_PPS
	default n
	help
	  Bench diagnostic. Each edge logs its cycle stamp and the interval since
	  the last one, which — interleaved with MESHTASTIC_GNSS_TIME_DEBUG's
	  per-callback line, stamped from the same counter — is how the NMEA
	  delivery latency was measured in the first place.

	  One line per second, forever. Off in shipping images.

config MESHTASTIC_GNSS_FIX_LATENCY_MS
	int "Assumed NMEA delivery latency, milliseconds"
	default 0
	range 0 999
	help
	  How long after the true UTC second the GNSS callback receives the
	  sentence naming it. Added back when the clock is anchored on the
	  sentence's ARRIVAL, which happens only when no trustworthy 1PPS edge is
	  available — with PPS the instant is measured rather than assumed and this
	  value is unused.

	  Zero by default, which is the historical behaviour. The delay is a
	  property of the receiver and its baud rate, not of this code, and a
	  guessed constant is worse than an honest offset of nothing: it moves the
	  clock by a confident amount in a direction nobody checked. Set it only
	  from a measurement on the hardware in question.

	  For reference, the figure measured on this project's bench — a Quectel
	  L76K at 9600 baud — is 853 ms, with about 6 ms of spread.

endif # MESHTASTIC_GNSS
