menuconfig MESHTASTIC_RELAY
	bool "Cross-preset text relay (receiving half)"
	default n
	help
	  The receiving half of a cross-preset relay (agents-jbrq.12). An "ear"
	  node on another preset forwards the frames it hears over the BLE peer
	  link. This node reads them through a channel it holds, and
	  RE-ORIGINATES broadcast text on its own preset as a new packet from
	  itself, prefixed "[xxxx] " with the origin's id.

	  Only text crosses. A position, NodeInfo or telemetry packet sent in the
	  relay's name would be the relay's, so those never cross; DMs are
	  PKC and cannot be read.

	  Channel mapping: every preset-named channel on exactly the default key
	  is one public channel (a LongFast frame goes out on this node's default
	  channel); a custom channel goes out on the same channel, which has the
	  same hash on every preset.

	  Loops are refused, not merely damped: any text already carrying a
	  relay-style prefix is dropped, a seen-cache keyed on (origin, text)
	  drops repeats, and a rate cap bounds the damage of anything that
	  gets past both.

	  Off at boot unless MESHTASTIC_RELAY_INBOUND_AT_BOOT, or unless a
	  direction was set before a reboot: with MESHTASTIC_SETTINGS the
	  direction and the ignore list are saved (mtrelay/relay).

if MESHTASTIC_RELAY

config MESHTASTIC_RELAY_INBOUND_AT_BOOT
	bool "Relay inbound (ear -> this preset) from boot"
	default n
	help
	  Start with the direction set to inbound. The default is off:
	  enabling a relay is a deliberate act. A direction set at runtime is
	  saved when MESHTASTIC_SETTINGS is on and wins over this; this is for
	  an image that must relay from its very first boot.

config MESHTASTIC_RELAY_SEEN_SIZE
	int "Seen-cache entries"
	default 16
	range 4 128
	help
	  Recently relayed (origin, text hash) pairs. A repeat inside the TTL is
	  dropped. The ear already drops a repeated (origin, packet id); this
	  catches the same text arriving under a NEW id, which is what a second
	  relay or a re-send produces.

config MESHTASTIC_RELAY_SEEN_TTL_SEC
	int "Seen-cache lifetime in seconds"
	default 300
	range 10 3600
	help
	  Matches the router's duplicate-cache lifetime. The cost of a long TTL
	  is that an origin sending the same short text twice (e.g. "ok") inside
	  it is relayed once.

config MESHTASTIC_RELAY_RATE_MAX
	int "Texts relayed per window"
	default 10
	range 1 255
	help
	  Token bucket per direction: at most this many texts per
	  MESHTASTIC_RELAY_RATE_WINDOW_SEC. Set it from the measured source
	  volume (the testbed's B1). The limit protects the destination tier's
	  airtime from a chatty or looping source.

config MESHTASTIC_RELAY_RATE_WINDOW_SEC
	int "Rate window in seconds"
	default 600
	range 10 86400

config MESHTASTIC_RELAY_PER_ORIGIN_MAX
	int "Texts relayed per origin per window"
	default 3
	range 1 255
	help
	  One node -- misbehaving, buggy, or hostile -- may not spend the whole
	  direction's cap (MESHTASTIC_RELAY_RATE_MAX) and starve everyone else.
	  Checked after the seen-cache and before the direction's cap.

config MESHTASTIC_RELAY_PER_ORIGIN_WINDOW_SEC
	int "Per-origin window in seconds"
	default 60
	range 10 86400

config MESHTASTIC_RELAY_ORIGIN_SLOTS
	int "Origins tracked by the per-origin limiter"
	default 8
	range 2 64
	help
	  A new origin takes the slot whose window started longest ago, so a
	  flood of invented origins cycles the table rather than growing it.

config MESHTASTIC_RELAY_LOG_INTERVAL_SEC
	int "At most one refusal log line per this many seconds"
	default 10
	range 1 3600
	help
	  Refusals worth a look (bad text, a relay prefix, the caps) are logged
	  with their first 16 bytes in hex; this bounds that log so a flooding
	  node cannot turn it into the attack. Held-back lines are counted.

config MESHTASTIC_RELAY_IGNORE_MAX
	int "Relay ids never translated"
	default 4
	range 1 16
	help
	  Nodes whose text is never relayed: other relays' destination halves.
	  The prefix refusal catches relays nobody listed; this catches a
	  relay that sends unprefixed text.

config MESHTASTIC_RELAY_QUEUE_SIZE
	int "Pending relayed texts"
	default 2
	range 1 16
	help
	  Texts accepted by the receive path and waiting for the work queue to
	  send them. Each slot holds a full text (~240 B).

endif # MESHTASTIC_RELAY

menuconfig MESHTASTIC_RELAY_EAR
	bool "Cross-preset relay: the ear"
	default n
	help
	  The other node of a cross-preset relay pair: it sits on the source
	  preset and forwards every broadcast TEXT frame it hears, byte for
	  byte, over the BLE peer link to the relay's receiving half
	  (MESHTASTIC_RELAY) on the destination preset.

	  The ear does not decide what crosses: the receiving half does, and
	  re-checks everything. The ear only avoids spending BLE on what could
	  never cross (DMs, non-text).

if MESHTASTIC_RELAY_EAR

config MESHTASTIC_RELAY_EAR_PEER
	hex "Receiving half's node id"
	default 0x0
	help
	  The node the ear forwards to, over whichever BLE peer link reaches
	  it. 0 means none until set at runtime (`meshtastic ear peer <id>`),
	  which is saved (mtear/peer) when MESHTASTIC_SETTINGS is on.

config MESHTASTIC_RELAY_EAR_QUEUE_SIZE
	int "Frames waiting to be forwarded"
	default 4
	range 1 32
	help
	  Each slot holds one wire frame (up to 256 B). Forwarding runs on the
	  BLE work queue, never on the LoRa receive thread.

config MESHTASTIC_RELAY_EAR_RATE_MAX
	int "Frames forwarded per window"
	default 30
	range 1 1000
	help
	  The ear does not judge content (the receiving half does), but a
	  flood of text frames on its preset must not saturate the peer link
	  or the receiving half. Excess frames are counted and dropped.

config MESHTASTIC_RELAY_EAR_RATE_WINDOW_SEC
	int "Ear forwarding window in seconds"
	default 60
	range 1 3600

config MESHTASTIC_RELAY_EAR_RX_ONLY
	bool "Compile the transmit path out"
	default y
	help
	  An ear usually sits on a PUBLIC channel it does not own. With this on
	  the image cannot key the radio at all (the same gate as
	  MESHTASTIC_SCANNER_RX_ONLY), so a stored tx_enabled, a phone or an
	  admin write cannot put it on someone else's air.

endif # MESHTASTIC_RELAY_EAR
