menuconfig MESHTASTIC_DEVICE_METRICS
	bool "Meshtastic device metrics telemetry"
	default y
	help
	  Enable Telemetry.device_metrics encoding and send helpers. Uptime is
	  always included.

if MESHTASTIC_DEVICE_METRICS

config MESHTASTIC_DEVICE_METRICS_AUTO_SEND
	bool "Automatically send device metrics"
	default y
	help
	  Send device metrics periodically after meshtastic_init().

	  This is the first-boot seed for ModuleConfig.telemetry's
	  device_telemetry_enabled: the phone can turn the
	  broadcast on or off afterwards. The reference ships it OFF (stock
	  2.7 broadcasts no device metrics until the user enables them);
	  this port defaults to ON so a bench node announces itself without
	  a phone. Set =n for parity with stock.

config MESHTASTIC_DEVICE_METRICS_INTERVAL_SEC
	int "Device metrics send interval in seconds"
	default 3600
	range 30 86400
	help
	  Interval between automatic device metrics Telemetry packets.
	  Defaults to 3600 s to match the reference client cadence
	  (default_telemetry_broadcast_interval_secs); 900 s was ~4x chattier.

config MESHTASTIC_FUEL_GAUGE
	bool "Include battery metrics from fuel_gauge0"
	depends on FUEL_GAUGE
	help
	  If devicetree alias fuel_gauge0 exists and is ready, include state
	  of charge and voltage in DeviceMetrics when the driver supports
	  those properties.

config MESHTASTIC_DEVICE_METRICS_TO_PHONE
	bool "Push DeviceMetrics to a connected phone on a faster cadence than the mesh broadcast"
	default y
	depends on MESHTASTIC_PHONEAPI
	help
	  agents-ooma.15: upstream's DeviceTelemetryModule::runOnce() pushes
	  DeviceMetrics to a connected phone on its own short timer
	  (sendToPhoneIntervalMs, ~60 s) independent of the much slower mesh
	  broadcast interval (MESHTASTIC_DEVICE_METRICS_INTERVAL_SEC, 3600 s
	  default) -- the phone app's battery/util/uptime readings are meant to be
	  live, not only as fresh as the last airtime-budgeted broadcast. This
	  port previously had one cadence for both.

	  Same mechanism and reasoning as MESHTASTIC_LOCAL_STATS_TO_PHONE just
	  above: meshtastic_phoneapi_on_packet() directly, never
	  meshtastic_send_data() -- zero airtime by construction, the frame never
	  reaches the radio. Independent of MESHTASTIC_DEVICE_METRICS_AUTO_SEND;
	  the phone push runs whether or not the mesh broadcast is even enabled,
	  matching upstream's runOnce() (the phone branch is not gated on
	  device_telemetry_enabled).

config MESHTASTIC_DEVICE_METRICS_TO_PHONE_SEC
	int "DeviceMetrics to-phone interval in seconds"
	default 60
	range 10 3600
	depends on MESHTASTIC_DEVICE_METRICS_TO_PHONE
	help
	  Matches upstream's sendToPhoneIntervalMs (DeviceTelemetry.h,
	  SECONDS_IN_MINUTE * 1000) -- one minute. Upstream's real trigger is
	  "every runOnce tick that isn't the mesh's turn to send", which this
	  port simplifies to a real independent timer, the same simplification
	  already made for MESHTASTIC_LOCAL_STATS_TO_PHONE_SEC (whose own upstream
	  trigger is a proper fixed interval, unlike this one, but the port keeps
	  both as plain per-job deadlines for one consistent dispatch shape).

endif # MESHTASTIC_DEVICE_METRICS

menuconfig MESHTASTIC_LOCAL_STATS
	bool "Meshtastic LocalStats telemetry"
	default y
	depends on MESHTASTIC_DEVICE_METRICS
	help
	  Enable Telemetry.local_stats -- the mesh-statistics variant: uptime,
	  channel/airtime utilization, packet and relay counters, node counts and
	  heap. Every counter it reports is one the stack already keeps; this only
	  puts them on the wire in the shape clients already render (the Android
	  app ships a dedicated LocalStats home-screen widget).

	  Note the deliberate asymmetry with device_metrics, which mirrors
	  upstream's DeviceTelemetryModule: LocalStats is pushed to a connected
	  PHONE only and is never broadcast over LoRa on a timer. It costs no
	  airtime. The mesh only ever sees it as a reply to an explicit
	  Telemetry(local_stats) request.

if MESHTASTIC_LOCAL_STATS

config MESHTASTIC_LOCAL_STATS_TO_PHONE
	bool "Push LocalStats to a connected phone periodically"
	default y
	depends on MESHTASTIC_PHONEAPI
	help
	  Enqueue a LocalStats frame onto every registered PhoneAPI transport on
	  a timer. Zero airtime -- the frame never reaches the radio.

config MESHTASTIC_LOCAL_STATS_TO_PHONE_SEC
	int "LocalStats to-phone interval in seconds"
	default 900
	range 30 86400
	depends on MESHTASTIC_LOCAL_STATS_TO_PHONE
	help
	  Matches upstream's sendStatsToPhoneIntervalMs (15 minutes).

endif # MESHTASTIC_LOCAL_STATS
