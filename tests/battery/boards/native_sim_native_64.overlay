/*
 * A vbatt voltage-divider node identical in shape to the Heltec V4-R8's (no
 * power-gpios -- the R8's divider is ungated, same as this test setup), backed
 * by native_sim's built-in emulated ADC controller (adc0, zephyr,adc-emul)
 * instead of a real Espressif SAR ADC. meshtastic_battery.c's real
 * implementation -- not a reimplementation of it -- compiles and runs against
 * this: the module's `#if DT_NODE_EXISTS(DT_NODELABEL(vbatt))` guard means
 * WITHOUT this overlay only the "no vbatt node" stub compiles, and there is
 * nothing to test. Same channel config as the real board
 * (heltec_wifi_lora32_v4-common.dtsi's &adc0 node): ADC_GAIN_4_5,
 * ADC_REF_INTERNAL, 12-bit.
 */
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc0 0>;
		output-ohms = <100000>;
		full-ohms = <(100000 + 390000)>;
	};
};

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_4_5";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
