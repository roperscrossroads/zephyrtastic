+/*
+ * Process a DIO1 IRQ that was asserted while the CPU was in light sleep.
+ *
+ * DIO1 is an EDGE interrupt (dio1_isr), but under PM_STATE_STANDBY the ESP32-S3
+ * GPIO peripheral is powered down, so the RX/TX-done rising edge is missed: on
+ * wake DIO1 is a static HIGH with no fresh edge, dio1_isr() never runs, and the
+ * frame sits unread. An application PM wake hook (pm_notifier .state_exit) calls
+ * this with the radio device on wake; if DIO1 is still asserted it submits the
+ * same work the edge ISR would have. Idempotent — k_work_submit() coalesces if
+ * already pending, and sx126x_irq_work_handler() reads+clears the SX126x IRQ
+ * status over SPI regardless of the (missed) GPIO edge. Takes the device
+ * explicitly because this driver instantiates for two compatibles (sx1261 /
+ * sx1262), so there is no single DEVICE_DT_INST_GET here.
+ */
+void sx126x_poll_dio1(const struct device *dev)
+{
+	const struct sx126x_hal_config *config = dev->config;
+	struct sx126x_data *data = dev->data;
+
+	if (gpio_pin_get_dt(&config->dio1) > 0) {
+		k_work_submit(&data->irq_work);
+	}
+}
