new file mode 100644
index 0000000..a50ebf0
--- /dev/null
+++ b/drivers/lora/native/sx126x/sx126x_busy_track.h
@@ -0,0 +1,128 @@
+/*
+ * SX126x BUSY-timeout accounting.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Split out of sx126x_hal_common.c so it can be unit-tested. That is not cosmetic: this
+ * predicate decides when the driver resets a wedged radio, it was wrong twice (carried
+ * patches 0020 and 0021), and both bugs shipped to hardware because the logic lived as
+ * file-scope statics inside a driver that only compiles for real targets. There was no
+ * surface to test. Now there is -- see main/tests/sx126x_busy.
+ *
+ * The two failures worth keeping in mind while reading this:
+ *
+ *   0020: the count was cleared by a success on ANY opcode. A chip wedged on SET_TX still
+ *         answers every other command, so the count never reached the threshold, the
+ *         recovery never ran, and a board failed 2514 transmits reporting `streak 0`.
+ *   0021: keying on the opcode alone was still not enough. Every command waits on BUSY
+ *         twice -- before the SPI transfer and after -- and the PRE wait cannot fail while
+ *         the chip is wedged, because the chip is idle until the command is issued. So the
+ *         pre-wait's success kept clearing the post-wait's count: 0,1,0,1, never 4.
+ *
+ * Hence the key is (opcode, phase). No Zephyr dependencies on purpose: a test should be
+ * able to include this and nothing else.
+ */
+
+#ifndef ZEPHYR_DRIVERS_LORA_SX126X_BUSY_TRACK_H_
+#define ZEPHYR_DRIVERS_LORA_SX126X_BUSY_TRACK_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Distinct (opcode, phase) pairs tracked at once. Static, no allocation. */
+#define SX126X_BUSY_TRACKED_WAITS 8
+
+struct sx126x_busy_wait {
+	uint8_t opcode;
+	bool post;
+	uint32_t count;
+};
+
+struct sx126x_busy_table {
+	struct sx126x_busy_wait w[SX126X_BUSY_TRACKED_WAITS];
+};
+
+/*
+ * Find the slot for (opcode, post). A slot with count 0 is free: the count IS the
+ * occupancy, which is why a cleared slot can be reused by a different wait.
+ */
+static inline uint32_t *sx126x_busy_slot(struct sx126x_busy_table *t, uint8_t opcode,
+					 bool post, bool create)
+{
+	uint32_t oldest = 0U;
+
+	for (int i = 0; i < SX126X_BUSY_TRACKED_WAITS; i++) {
+		if (t->w[i].count != 0U && t->w[i].opcode == opcode && t->w[i].post == post) {
+			return &t->w[i].count;
+		}
+	}
+	if (!create) {
+		return NULL;
+	}
+	for (int i = 0; i < SX126X_BUSY_TRACKED_WAITS; i++) {
+		if (t->w[i].count == 0U) {
+			t->w[i].opcode = opcode;
+			t->w[i].post = post;
+			return &t->w[i].count;
+		}
+	}
+	/* Table full: reuse the least-stuck entry rather than losing the newest signal. */
+	for (int i = 1; i < SX126X_BUSY_TRACKED_WAITS; i++) {
+		if (t->w[i].count < t->w[oldest].count) {
+			oldest = (uint32_t)i;
+		}
+	}
+	t->w[oldest].opcode = opcode;
+	t->w[oldest].post = post;
+	t->w[oldest].count = 0U;
+	return &t->w[oldest].count;
+}
+
+/** A wait on (opcode, phase) timed out. */
+static inline void sx126x_busy_record_timeout(struct sx126x_busy_table *t, uint8_t opcode,
+					      bool post)
+{
+	uint32_t *slot = sx126x_busy_slot(t, opcode, post, true);
+
+	if (slot != NULL) {
+		(*slot)++;
+	}
+}
+
+/**
+ * A wait on (opcode, phase) succeeded.
+ *
+ * Clears ONLY that pair. Neither another opcode nor this opcode's other phase may clear it:
+ * both of those were the bugs.
+ */
+static inline void sx126x_busy_record_success(struct sx126x_busy_table *t, uint8_t opcode,
+					      bool post)
+{
+	uint32_t *slot = sx126x_busy_slot(t, opcode, post, false);
+
+	if (slot != NULL) {
+		*slot = 0U;
+	}
+}
+
+/** Worst count of any tracked wait -- "how stuck is this radio". */
+static inline uint32_t sx126x_busy_worst(const struct sx126x_busy_table *t)
+{
+	uint32_t worst = 0U;
+
+	for (int i = 0; i < SX126X_BUSY_TRACKED_WAITS; i++) {
+		if (t->w[i].count > worst) {
+			worst = t->w[i].count;
+		}
+	}
+	return worst;
+}
+
+/** Forget everything -- called after the recovery resets the chip. */
+static inline void sx126x_busy_reset(struct sx126x_busy_table *t)
+{
+	memset(t, 0, sizeof(*t));
+}
+
+#endif /* ZEPHYR_DRIVERS_LORA_SX126X_BUSY_TRACK_H_ */
