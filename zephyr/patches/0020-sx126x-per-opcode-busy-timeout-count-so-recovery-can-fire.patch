+ * agents-oieb: count of BUSY-wait timeouts. A wedged radio (BUSY stuck high) stacks
+ * these up; the driver triggers a chip reset when the count crosses a threshold.
+ * Module-scope (single radio on the target), like sx126x_last_issued_opcode above.
+ *
+ * agents-3raz: this used to be a strictly CONSECUTIVE count, cleared on ANY successful
+ * wait across ALL opcodes -- and that predicate cannot see the failure it exists to
+ * recover from. A chip that is wedged on one command still answers the others: on the
+ * bench, a board whose SET_TX never cleared BUSY kept completing its pre-waits, CAD,
+ * WRITE_REGISTER and GET_IRQ_STATUS normally. Every one of those reset the streak, so it
+ * never reached the threshold of 4, the recovery in sx126x_lora_config() never ran, and
+ * the board sat with 100% of its transmits failing for eleven hours while reporting
+ * `SPI BUSY streak 0`. 2514 failed transmits, streak zero, recovery check running
+ * thousands of times and always seeing nothing.
+ *
+ * So: only a success on the SAME opcode clears that opcode's count. A success elsewhere
+ * no longer erases the evidence of a per-command wedge. The reported streak is the worst
+ * opcode's count, which keeps the existing accessor (and `meshtastic rf`'s "SPI BUSY
+ * streak" row) meaning "how stuck is this radio".
  */
-static uint32_t sx126x_busy_streak;
+#define SX126X_BUSY_TRACKED_OPCODES 8
+
+static struct {
+	uint8_t opcode;
+	uint32_t count;
+} sx126x_busy_fail[SX126X_BUSY_TRACKED_OPCODES];
+
+static uint32_t *sx126x_busy_slot(uint8_t opcode, bool create)
+{
+	uint32_t oldest = 0U;
+
+	for (int i = 0; i < SX126X_BUSY_TRACKED_OPCODES; i++) {
+		if (sx126x_busy_fail[i].count != 0U && sx126x_busy_fail[i].opcode == opcode) {
+			return &sx126x_busy_fail[i].count;
+		}
+	}
+	if (!create) {
+		return NULL;
+	}
+	for (int i = 0; i < SX126X_BUSY_TRACKED_OPCODES; i++) {
+		if (sx126x_busy_fail[i].count == 0U) {
+			sx126x_busy_fail[i].opcode = opcode;
+			return &sx126x_busy_fail[i].count;
+		}
+	}
+	/* Table full: reuse the least-stuck entry rather than losing the newest signal. */
+	for (int i = 1; i < SX126X_BUSY_TRACKED_OPCODES; i++) {
+		if (sx126x_busy_fail[i].count < sx126x_busy_fail[oldest].count) {
+			oldest = (uint32_t)i;
+		}
+	}
+	sx126x_busy_fail[oldest].opcode = opcode;
+	sx126x_busy_fail[oldest].count = 0U;
+	return &sx126x_busy_fail[oldest].count;
+}
 
 uint32_t sx126x_hal_busy_timeout_streak(void)
 {
-	return sx126x_busy_streak;
+	uint32_t worst = 0U;
+
+	for (int i = 0; i < SX126X_BUSY_TRACKED_OPCODES; i++) {
+		if (sx126x_busy_fail[i].count > worst) {
+			worst = sx126x_busy_fail[i].count;
+		}
+	}
+	return worst;
 }
 
 void sx126x_hal_busy_timeout_streak_reset(void)
 {
-	sx126x_busy_streak = 0U;
+	memset(sx126x_busy_fail, 0, sizeof(sx126x_busy_fail));
 }
 
