-int sx126x_hal_wait_busy(const struct device *dev, uint32_t timeout_ms);
+/*
+ * Wait for BUSY to fall LOW, up to timeout_ms. @p opcode is the command being
+ * gated (0x00 for reset/init waits with no command). @p post is false for the
+ * wait BEFORE the SPI transfer (a timeout there means the PRIOR op left BUSY high)
+ * and true for the wait AFTER it (a timeout means THIS command did not complete);
+ * standalone readiness waits (reset/wakeup) pass true. Both only tag a timeout for
+ * diagnostics — see sx126x_hal_busy_timeout_report().
+ */
+int sx126x_hal_wait_busy(const struct device *dev, uint32_t timeout_ms, uint8_t opcode,
+			 bool post);
+
+/*
+ * Called once by sx126x_hal_wait_busy() whenever a BUSY wait times out. @p
+ * prev_opcode is the last command actually issued over SPI — on a PRE timeout that
+ * is the op that left BUSY high (the culprit). The driver ships a __weak default
+ * that LOG_WRNs opcode + pre/post phase + prev_opcode; an application can override
+ * it (strong symbol) to add context it owns — e.g. correlating with the last
+ * light-sleep wake. Runs in the caller's context (thread or the driver workqueue),
+ * never an ISR.
+ */
+void sx126x_hal_busy_timeout_report(const struct device *dev, uint8_t opcode,
+				    uint32_t timeout_ms, bool post, uint8_t prev_opcode);
 
 bool sx126x_hal_is_busy(const struct device *dev);
 
