+/*
+ * Diagnostics (agents-qnpp): opcode of the last command actually issued over SPI.
+ * A PRE-wait BUSY timeout means the PRIOR op left BUSY high; logging this names it.
+ * Module-scope (single radio on the target); a torn read across the TX thread and
+ * the RX workqueue at worst mislabels one diagnostic line. Set at every command
+ * header transfer (hdr[0] is the opcode) plus the wakeup path below.
+ */
+static uint8_t sx126x_last_issued_opcode;
+
 static int spi_transfer(const struct spi_dt_spec *spi,
 			const uint8_t *hdr, size_t hdr_len,
 			uint8_t *data, size_t data_len, bool read)
@@ -24,6 +33,10 @@ static int spi_transfer(const struct spi_dt_spec *spi,
 
 	__ASSERT_NO_MSG(hdr_len <= sizeof(rx_hdr));
 
+	if (hdr_len > 0) {
+		sx126x_last_issued_opcode = hdr[0];
+	}
+
 	struct spi_buf tx_bufs[] = {
 		{ .buf = (uint8_t *)hdr, .len = hdr_len },
 		{ .buf = read ? NULL : data, .len = data_len },
@@ -39,12 +52,31 @@ static int spi_transfer(const struct spi_dt_spec *spi,
 	return spi_transceive_dt(spi, &tx_set, read ? &rx_set : NULL);
 }
 
-int sx126x_hal_wait_busy(const struct device *dev, uint32_t timeout_ms)
+/*
+ * __weak default: on a BUSY timeout, log the opcode + pre/post phase. The opcode
+ * tells TX-path (SET_TX_PARAMS / WRITE_BUFFER) from RX-path (GET_IRQ_STATUS /
+ * READ_BUFFER) and config; the phase tells whether the PRIOR op left BUSY high
+ * (pre) or this command did not complete (post). An application may override this
+ * (strong symbol) to add more context — see the declaration in sx126x_hal.h.
+ */
+__weak void sx126x_hal_busy_timeout_report(const struct device *dev, uint8_t opcode,
+					   uint32_t timeout_ms, bool post, uint8_t prev_opcode)
+{
+	ARG_UNUSED(dev);
+	LOG_WRN("Busy timeout after %u ms (op=0x%02x %s, prev=0x%02x)", timeout_ms, opcode,
+		post ? "post" : "pre", prev_opcode);
+}
+
+int sx126x_hal_wait_busy(const struct device *dev, uint32_t timeout_ms, uint8_t opcode,
+			 bool post)
 {
 	if (!WAIT_FOR(!sx126x_hal_is_busy(dev),
 		      timeout_ms * 1000,
