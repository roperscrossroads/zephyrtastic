diff --git a/include/zephyr/arch/xtensa/fault_breadcrumbs.h b/include/zephyr/arch/xtensa/fault_breadcrumbs.h
new file mode 100644
index 0000000000..9cae19a985
--- /dev/null
+++ b/include/zephyr/arch/xtensa/fault_breadcrumbs.h
@@ -0,0 +1,138 @@
+/*
+ * Copyright (c) 2026 Adam Roper
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * @file
+ * @brief Fault breadcrumbs that survive a warm reset (CONFIG_XTENSA_FAULT_BREADCRUMBS)
+ *
+ * Neither record is cleared by the architecture: they are written by the
+ * double-exception vector and the interrupt C handlers and left for the next
+ * boot to read. An application that wants "the previous run" semantics copies
+ * them out early (before interrupts matter) and clears them; on a cold boot the
+ * contents are undefined, so xtensa_dblexc_record.magic is the only validity
+ * signal for that record and the application must decide for xtensa_irq_stats
+ * (typically from its own retained-RAM marker).
+ */
+
+#ifndef ZEPHYR_INCLUDE_ARCH_XTENSA_FAULT_BREADCRUMBS_H_
+#define ZEPHYR_INCLUDE_ARCH_XTENSA_FAULT_BREADCRUMBS_H_
+
+#ifndef _ASMLANGUAGE
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Written LAST by the vector, so a torn record is never trusted. "DBLX". */
+#define XTENSA_DBLEXC_MAGIC 0x44424c58U
+
+/**
+ * What the CPU could still say at a double exception.
+ *
+ * Offsets are load-bearing: the vector code stores by fixed offset. Keep the
+ * field order and sizes in step with _xtensa_dblexc_breadcrumb in
+ * xtensa_asm2_util.S.
+ */
+struct xtensa_dblexc_record {
+	uint32_t magic;    /**< XTENSA_DBLEXC_MAGIC once the rest is valid */
+	uint32_t exccause; /**< cause of the SECOND exception (the one the handler raised) */
+	uint32_t epc1;     /**< PC of the FIRST exception, the one being handled */
+	uint32_t depc;     /**< PC of the second exception, inside the handler */
+	uint32_t excvaddr; /**< faulting address, when the cause has one */
+	uint32_t ps;       /**< PS at the double exception */
+	uint32_t a0;       /**< a0 on entry to the vector */
+	uint32_t a1;       /**< a1 (stack pointer) on entry to the vector */
+	uint32_t current;  /**< struct k_thread * that was _current (valid only with ext_valid) */
+	uint32_t nested;   /**< _cpu.nested, the ISR nesting count (valid only with ext_valid) */
+	uint32_t excsave1; /**< EXCSAVE1, whatever the level-1 path had stashed */
+	/**
+	 * Non-zero once current/nested were read. Everything above them comes
+	 * from special registers and cannot fault; those two are loads through
+	 * the CPU struct pointer, which CAN fault when the machine is already
+	 * corrupt (a runaway recursion that walked through _kernel, say). The
+	 * recorder writes the magic before attempting them, and a second double
+	 * exception raised inside the recorder finds the magic set and spins
+	 * without touching the record, so a fault there costs these two fields,
+	 * not the record.
+	 */
+	uint32_t ext_valid;
+};
+
+/** Index = interrupt level (1..XCHAL_NUM_INTLEVELS); slot 0 is unused. */
+#define XTENSA_IRQ_STATS_LEVELS 8
+
+/**
+ * Per-level interrupt accounting, cumulative since it was last cleared.
+ *
+ * An entry that dispatches nothing means the level's vector fired but no
+ * pending+enabled interrupt in that level's mask was found -- the shape of a
+ * storm from a source the C dispatcher does not own. The raw group-0
+ * INTERRUPT & INTENABLE mask seen at the last such entry is kept for that
+ * case.
+ */
+struct xtensa_irq_stats {
+	uint32_t entries[XTENSA_IRQ_STATS_LEVELS];
+	uint32_t dispatched[XTENSA_IRQ_STATS_LEVELS];
+	uint32_t undispatched[XTENSA_IRQ_STATS_LEVELS];
+	uint32_t last_irq[XTENSA_IRQ_STATS_LEVELS];
+	uint32_t last_undispatched_mask[XTENSA_IRQ_STATS_LEVELS];
+	/**
+	 * Level-1 entries that were exceptions rather than interrupts, with the
+	 * last cause and PC. Some causes return silently (a coprocessor-disabled
+	 * trap, a syscall), so a storm of them is invisible to the counters
+	 * above; a fatal one prints, but only if the fatal path still works.
+	 */
+	uint32_t exc_entries;
+	uint32_t exc_last_cause;
+	uint32_t exc_last_pc;
+	/**
+	 * Interrupt C-handler entries that found _cpu.nested <= 0. Inside an
+	 * ISR it must be >= 1; anything else means the exit path ran once more
+	 * than the entry path (an underflow), after which every later interrupt
+	 * skips the switch to the interrupt stack and runs on the interrupted
+	 * thread's stack. The first occurrence is kept: the level and the
+	 * nested value seen, the thread that was current, and the last IRQ
+	 * dispatched per level at that moment (the culprit exited just before).
+	 */
+	uint32_t nested_bad;
+	uint32_t nested_bad_first_level;
+	uint32_t nested_bad_first_value;
+	uint32_t nested_bad_first_thread;
+	uint32_t nested_bad_first_last_irq[XTENSA_IRQ_STATS_LEVELS];
+	/**
+	 * Interrupt C-handler EXITS that found _cpu.nested < 1 after the ISR
+	 * bodies ran: an ISR changed the count, i.e. something switched context
+	 * from inside an interrupt handler. First occurrence kept with the level,
+	 * the IRQ last dispatched at that level (the ISR that did it), the value
+	 * seen and the thread that was current afterwards.
+	 */
+	uint32_t nested_broken_by_isr;
+	uint32_t nested_broken_first_level;
+	uint32_t nested_broken_first_irq;
+	uint32_t nested_broken_first_value;
+	uint32_t nested_broken_first_thread;
+};
+
+#ifdef CONFIG_XTENSA_ISR_NESTING_GUARD
+/** [0] entries that found nested < 0 (started from 0), [1] exits floored at 0. */
+extern uint32_t xtensa_nesting_clamps[2];
+#endif
+
+extern struct xtensa_dblexc_record xtensa_dblexc_record;
+extern struct xtensa_irq_stats xtensa_irq_stats;
+
+/** @brief EXCCAUSE code to a short name (arch/xtensa/core/fatal.c). */
+char *xtensa_exccause(unsigned int cause_code);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _ASMLANGUAGE */
+
+#endif /* ZEPHYR_INCLUDE_ARCH_XTENSA_FAULT_BREADCRUMBS_H_ */
