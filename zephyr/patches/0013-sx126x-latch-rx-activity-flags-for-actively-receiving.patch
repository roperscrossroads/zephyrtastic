+/*
+ * Is a packet being demodulated right now? Parity: upstream Meshtastic's
+ * SX126xInterface::isActivelyReceiving() reads the IRQ status register and
+ * looks at HEADER_VALID | PREAMBLE_DETECTED. This is the chip half of that; the
+ * false-detection timing (a preamble that never became a header, a header that
+ * never became a packet) lives in the caller, because it needs the modem's
+ * preamble and packet times, which the driver does not compute.
+ *
+ * Reports through two booleans rather than raw flags so the caller stays
+ * chip-agnostic (the simulated radio answers the same question). A HEADER_ERR
+ * means the attempt is over -- the header CRC failed -- so it is retired here:
+ * the three bits are cleared and the answer is "nothing in progress".
+ *
+ * Only meaningful, and only issued, while the chip is in RX: any SPI
+ * transaction wakes a sleeping SX126x, which would defeat NATIVE_SLEEP, and in
+ * every other state the answer is trivially "no". Under data->lock, which
+ * serialises against the config/send/sleep paths that reprogram the mask; the
+ * IRQ work handler runs unlocked, but it only ever reads status and clears
+ * what it read, so interleaving with this read-and-clear of a disjoint bit set
+ * is harmless.
+ */
+int sx126x_rx_activity(const struct device *dev, bool *preamble, bool *header)
+{
+	struct sx126x_data *data = dev->data;
+	uint16_t status = 0;
+	atomic_val_t state;
+	int ret = 0;
+
+	*preamble = false;
+	*header = false;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+
+	state = atomic_get(&data->state);
+	if (state != SX126X_STATE_RX && state != SX126X_STATE_RX_DUTY_CYCLE) {
+		goto out;
+	}
+
+	ret = sx126x_get_irq_status(dev, &status);
+	if (ret < 0) {
+		goto out;
+	}
+
+	if (status & SX126X_IRQ_HEADER_ERR) {
+		ret = sx126x_clear_irq_status(dev, SX126X_IRQ_RX_ACTIVITY);
+		goto out;
+	}
+
+	*preamble = (status & SX126X_IRQ_PREAMBLE_DETECTED) != 0U;
+	*header = (status & SX126X_IRQ_HEADER_VALID) != 0U;
+
+out:
+	k_mutex_unlock(&data->lock);
+	return ret;
+}
+
+/*
+ * Retire a stale detection: the caller has decided, on timing, that the
+ * latched preamble/header flag is not a packet after all. Upstream leaves the
+ * bit latched and re-times it on every call, which makes its answer oscillate
+ * on a stale flag; clearing it is the honest fix. Same state and lock rules as
+ * sx126x_rx_activity().
+ */
+int sx126x_rx_activity_clear(const struct device *dev)
+{
+	struct sx126x_data *data = dev->data;
+	atomic_val_t state;
+	int ret = 0;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+
+	state = atomic_get(&data->state);
+	if (state == SX126X_STATE_RX || state == SX126X_STATE_RX_DUTY_CYCLE) {
+		ret = sx126x_clear_irq_status(dev, SX126X_IRQ_RX_ACTIVITY);
+	}
+
+	k_mutex_unlock(&data->lock);
+	return ret;
+}
