+/*
+ * The standing DIO1 interrupt set: the terminal events the IRQ work handler
+ * acts on. Unchanged from before the RX-activity work below.
+ */
+#define SX126X_IRQ_STD_DIO1 \
+	(SX126X_IRQ_TX_DONE | SX126X_IRQ_RX_DONE | SX126X_IRQ_RX_TX_TIMEOUT | \
+	 SX126X_IRQ_CRC_ERR)
+
+/*
+ * RX-activity flags: the non-terminal receive events that say "a packet is
+ * being demodulated right now". They are ENABLED in the IRQ mask so they latch
+ * in the status register, but deliberately NOT routed to DIO1 -- a preamble
+ * detection is not an event to act on, only a fact to consult. This is how
+ * RadioLib configures the chip for Meshtastic (RADIOLIB_IRQ_RX_DEFAULT_FLAGS
+ * plus PREAMBLE_DETECTED in the enable mask, RX_DONE alone on DIO1), and it is
+ * the entire mechanism behind upstream's isActivelyReceiving(): read the
+ * status register, look at these bits.
+ *
+ * Without them in the enable mask the bits never latch at all, so no amount of
+ * reading the status register can tell a caller a packet is arriving. That was
+ * the state of this driver before 2026-09-02, which is why the periodic AGC
+ * reset and every transmit could land on top of an inbound frame.
+ *
+ * HEADER_ERR is in the set for the opposite reason: it marks the END of an
+ * attempt (the header CRC failed, the demodulator has given up), so a reader
+ * can retire a stale preamble flag immediately instead of waiting out the
+ * timing heuristic in the layer above.
+ */
+#define SX126X_IRQ_RX_ACTIVITY \
+	(SX126X_IRQ_PREAMBLE_DETECTED | SX126X_IRQ_HEADER_VALID | SX126X_IRQ_HEADER_ERR)
+
+/* What the IRQ enable mask carries between operations. */
+#define SX126X_IRQ_STD_ENABLE (SX126X_IRQ_STD_DIO1 | SX126X_IRQ_RX_ACTIVITY)
+
