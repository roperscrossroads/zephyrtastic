+/**
+ * @brief What the controller blob asked of the OS interface that the OS could
+ *        not honour as asked, and what its ISR did to kernel state.
+ *
+ * The controller library was written to FreeRTOS conventions. The adapter
+ * translates its OS-interface calls; where a call is legal in FreeRTOS but not
+ * in Zephyr (a yield or a blocking wait from interrupt context) the adapter now
+ * refuses the illegal part, does the nearest safe thing, and counts it here
+ * instead of letting the kernel's interrupt bookkeeping be corrupted. The
+ * ISR-side fields come from a guard around the controller's interrupt handler
+ * that compares the kernel's ISR nesting count and PS.INTLEVEL before and after
+ * the handler ran, and restores the count if the handler changed it.
+ *
+ * Read-only for callers; cumulative since boot; lives in ordinary RAM.
+ */
+struct esp_bt_osi_stats {
+    uint32_t yield_from_isr_in_isr;   /**< _task_yield_from_isr called in ISR context (refused) */
+    uint32_t yield_from_isr_in_thread;/**< _task_yield_from_isr called in thread context (honoured) */
+    uint32_t block_in_isr;            /**< a blocking take/recv/lock asked for in ISR context (made non-blocking) */
+    uint32_t isr_calls;               /**< controller interrupt handler invocations seen by the guard */
+    uint32_t isr_changed_nesting;     /**< handler returned with the kernel ISR nesting count changed (restored) */
+    uint32_t isr_changed_intlevel;    /**< handler returned with PS.INTLEVEL changed */
+    uint32_t isr_last_nesting_delta;  /**< the last such nesting change, as a signed delta */
+};
+
+extern struct esp_bt_osi_stats esp_bt_osi_stats;
+
 #ifdef __cplusplus
 }
 #endif
