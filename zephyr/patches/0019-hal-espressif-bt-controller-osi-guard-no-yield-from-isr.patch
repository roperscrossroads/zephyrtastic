 static void IRAM_ATTR task_yield_from_isr(void)
 {
+    /* FreeRTOS's portYIELD_FROM_ISR. Zephyr reschedules on interrupt exit by
+     * itself, and k_yield() from an ISR is a context switch out of interrupt
+     * context: the interrupted context's interrupt exit never runs, the ISR
+     * nesting count is left one too high, and the machine is doomed from
+     * there. So in ISR context this is a counted no-op. From thread context
+     * (the controller does call it there) a yield is legal and honoured. */
+    if (k_is_in_isr()) {
+        esp_bt_osi_stats.yield_from_isr_in_isr++;
+        return;
+    }
+    esp_bt_osi_stats.yield_from_isr_in_thread++;
     k_yield();
 }
 
