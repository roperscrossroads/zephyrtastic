+/* Guard around the controller's interrupt handler. The handler is a blob
+ * written to FreeRTOS conventions; the kernel's per-CPU ISR nesting count and
+ * PS.INTLEVEL must be exactly what they were when it returns, or every later
+ * interrupt runs on the wrong stack. Compare, count, and put the count back.
+ * At most BT_ISR_GUARD_MAX handlers (the controller allocates one per source). */
+#define BT_ISR_GUARD_MAX 4
+struct bt_isr_guard {
+    intr_handler_t fn;
+    void *arg;
+};
+static struct bt_isr_guard bt_isr_guards[BT_ISR_GUARD_MAX];
+
+static void IRAM_ATTR bt_isr_guarded(void *arg)
+{
+    struct bt_isr_guard *g = arg;
+    int nested_before = _kernel.cpus[0].nested;
+    uint32_t ps_before, ps_after;
+
+    __asm__ volatile("rsr.ps %0" : "=r"(ps_before));
+    esp_bt_osi_stats.isr_calls++;
+    g->fn(g->arg);
+    __asm__ volatile("rsr.ps %0" : "=r"(ps_after));
+    if (_kernel.cpus[0].nested != nested_before) {
+        esp_bt_osi_stats.isr_changed_nesting++;
+        esp_bt_osi_stats.isr_last_nesting_delta =
+            (uint32_t)(_kernel.cpus[0].nested - nested_before);
+        _kernel.cpus[0].nested = nested_before;
+    }
+    if ((ps_after & 0xfU) != (ps_before & 0xfU)) {
+        esp_bt_osi_stats.isr_changed_intlevel++;
+    }
+}
+
 static void btdm_intr_alloc(void *arg)
 {
     btdm_isr_alloc_t *p = arg;
-    p->ret = esp_intr_alloc(p->source, p->flags, p->fn, p->arg, p->handle);
+    struct bt_isr_guard *g = NULL;
+
+    for (int i = 0; i < BT_ISR_GUARD_MAX; i++) {
+        if (bt_isr_guards[i].fn == NULL || bt_isr_guards[i].fn == p->fn) {
+            g = &bt_isr_guards[i];
+            break;
+        }
+    }
+    if (g != NULL) {
+        g->fn = p->fn;
+        g->arg = p->arg;
+        p->ret = esp_intr_alloc(p->source, p->flags, bt_isr_guarded, g, p->handle);
+    } else {
+        p->ret = esp_intr_alloc(p->source, p->flags, p->fn, p->arg, p->handle);
+    }
 }
 
