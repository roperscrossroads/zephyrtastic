-	/* Set RX gain */
-	ret = sx126x_set_rx_gain(dev, hal_config->rx_boosted);
+	/* Set RX gain. data->rx_boosted, not hal_config->rx_boosted: the former
+	 * is runtime-overridable (sx126x_set_rx_boosted_gain), the latter is the
