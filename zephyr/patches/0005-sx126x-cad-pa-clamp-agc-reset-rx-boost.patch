+ * p.92. Confirmed against RadioLib source (SX126x_commands.cpp setCad(),
+ * 2026-08-06): symbolNum defaults to 4 symbols, detPeak to spreadingFactor+13
+ * (SF-dependent, not fixed), detMin to 10, exitMode always GOTO_STDBY. */
+#define SX126X_CAD_ON_1_SYMB                0x00
+#define SX126X_CAD_ON_2_SYMB                0x01
+#define SX126X_CAD_ON_4_SYMB                0x02
+#define SX126X_CAD_ON_8_SYMB                0x03
+#define SX126X_CAD_ON_16_SYMB               0x04
+#define SX126X_CAD_GOTO_STDBY               0x00
+#define SX126X_CAD_GOTO_RX                  0x01
+#define SX126X_CAD_PARAM_DET_MIN_DEFAULT    10U
+
 /* Packet Types */
 #define SX126X_PACKET_TYPE_GFSK             0x00
 #define SX126X_PACKET_TYPE_LORA             0x01
@@ -183,6 +199,12 @@
 /* TX Clamp Config (workaround for SX1262) */
 #define SX126X_REG_TX_CLAMP_CFG             0x08D8
 
+/* RX sensitivity patch bit, re-applied by the periodic AGC-reset warm-sleep
+ * cycle (upstream Meshtastic resetAGC(), empirically necessary -- see
+ * SX126x_hal.c's sx126x_reset_agc()). Bit 0 only; other bits preserved. */
+#define SX126X_REG_RX_SENSITIVITY_PATCH     0x08B5
+#define SX126X_RX_SENSITIVITY_PATCH_BIT     BIT(0)
+
 /* Over Current Protection */
 #define SX126X_REG_OCP                      0x08E7
 
diff --git a/drivers/lora/native/sx126x/sx126x_hal.c b/drivers/lora/native/sx126x/sx126x_hal.c
index ca61427..845251b 100644
--- a/drivers/lora/native/sx126x/sx126x_hal.c
+++ b/drivers/lora/native/sx126x/sx126x_hal.c
@@ -195,6 +195,35 @@ static int sx126x_hal_set_pa_config(const struct device *dev, uint8_t pa_duty_cy
 	return sx126x_hal_write_cmd(dev, SX126X_CMD_SET_PA_CONFIG, buf, 4);
 }
 
+/*
+ * SX1262/SX1268 PA-clamping errata fix (datasheet "Known Limitations" ch. 15,
+ * sec. 15.2): the default TX_CLAMP_CFG value makes the PA's over-current
+ * clamp overly eager, silently capping actual output power below what was
+ * configured -- worse at higher power and with antenna mismatch, with no
+ * error raised anywhere. RadioLib (the library upstream Meshtastic uses)
+ * applies this unconditionally for every SX1262/SX1268 via fixPaClamping();
+ * the STM32WL HAL variant in this same driver tree already carries an
+ * equivalent read-modify-write (same 0x1E mask) but only for that variant --
+ * this is the SX1262 discrete-chip path (e.g. Heltec V4's SPI-connected
+ * SX1262), which had no equivalent until now. Idempotent: safe to OR in on
+ * every TX-params configure, matching the STM32WL variant's own call site
+ * rather than a one-time init hook.
+ */
+static int sx126x_hal_fix_pa_clamping(const struct device *dev)
+{
+	uint8_t reg_val;
+	int ret;
+
+	ret = sx126x_hal_read_regs(dev, SX126X_REG_TX_CLAMP_CFG, &reg_val, 1);
+	if (ret < 0) {
+		return ret;
+	}
+
+	reg_val |= (0x0F << 1);
+
+	return sx126x_hal_write_regs(dev, SX126X_REG_TX_CLAMP_CFG, &reg_val, 1);
+}
+
 int sx126x_hal_configure_tx_params(const struct device *dev, int8_t power,
 				   uint32_t frequency, uint8_t ramp_time)
 {
@@ -228,6 +257,12 @@ int sx126x_hal_configure_tx_params(const struct device *dev, int8_t power,
 		if (ret < 0) {
 			return ret;
 		}
+
+		ret = sx126x_hal_fix_pa_clamping(dev);
+		if (ret < 0) {
+			return ret;
+		}
+
 		tx_power = CLAMP(power, SX1262_MIN_POWER, SX1262_MAX_POWER);
 	}
 
