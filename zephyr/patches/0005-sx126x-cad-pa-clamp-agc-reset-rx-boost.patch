+/*
+ * Override the RX gain boost mode set at init from devicetree (data->rx_boosted).
+ * Stages the new value only -- it takes effect on the next sx126x_lora_config(),
+ * which reads data->rx_boosted (not hal_config->rx_boosted) on every call. No
+ * immediate SPI write here deliberately: the RX_GAIN register is only valid to
+ * write in STANDBY (datasheet §9.6), and the caller may reach this from an
+ * arbitrary radio state (asleep, mid-RX). The existing config-apply path
+ * already handles that transition correctly, so this reuses it rather than
+ * duplicating state handling. Takes the device explicitly, same reasoning as
+ * sx126x_poll_dio1 (two compatibles, no single DEVICE_DT_INST_GET here).
+ */
+int sx126x_set_rx_boosted_gain(const struct device *dev, bool boosted)
+{
+	struct sx126x_data *data = dev->data;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	data->rx_boosted = boosted;
+	k_mutex_unlock(&data->lock);
+
+	return 0;
+}
+
+/* Bounds the CAD wait so a lost DIO1 edge can't hang a TX forever. Generous
+ * relative to the worst case (4 symbols at SF12/BW125 is ~131 ms) --
+ * matches this driver's existing conservative timeout style
+ * (SX126X_BUSY_DEFAULT_TIMEOUT). */
+#define SX126X_CAD_TIMEOUT_MS 1000U
+
+/*
+ * Channel Activity Detection before TX -- fulfils the documented
+ * lora_modem_config.cad contract (LORA_CAD_MODE_LBT: "lora_send() performs
+ * CAD before transmitting and returns -EBUSY if the channel is busy") that
+ * this driver accepted in its config struct but never actually implemented.
+ *
+ * Parameters: symbol_num/detection_peak/detection_minimum of 0 mean "auto" --
+ * resolved here to the same defaults RadioLib uses for the SX1262 (the
+ * library upstream Meshtastic itself runs), confirmed against RadioLib
+ * source 2026-08-06: 4-symbol window, detPeak = spreadingFactor + 13
+ * (SF-dependent), detMin = 10, always exits to STDBY_RC regardless of
+ * result. A caller may override any of the three explicitly.
+ *
+ * Caller contract: must hold data->lock and have the chip in a state where
+ * SetCadParams/SetCad are valid (sx126x_ensure_ready() has already run) --
+ * matches how sx126x_lora_send_async() is already structured. Restores the
+ * driver's standard TX/RX/timeout/CRC-err DIO1 mask before returning either
+ * way, since SetCadParams' own IRQ configuration otherwise displaces it.
+ *
+ * Returns 0 (clear), -EBUSY (activity detected -- the exact contract the
+ * upper layers, up through meshtastic_radio.c's retry loop, already expect
+ * from a busy channel), or a negative errno on a communication failure.
+ */
+static int sx126x_do_cad(const struct device *dev, const struct lora_modem_config *config)
+{
+	const struct sx126x_hal_config *hal_config = dev->config;
+	uint8_t symbol_code;
+	uint8_t det_peak;
+	uint8_t det_min;
+	uint8_t params[7];
+	uint16_t status = 0;
+	int64_t deadline;
+	int ret;
+
+	switch (config->cad.symbol_num) {
+	case LORA_CAD_SYMB_1:
+		symbol_code = SX126X_CAD_ON_1_SYMB;
+		break;
+	case LORA_CAD_SYMB_2:
+		symbol_code = SX126X_CAD_ON_2_SYMB;
+		break;
+	case LORA_CAD_SYMB_8:
+		symbol_code = SX126X_CAD_ON_8_SYMB;
+		break;
+	case LORA_CAD_SYMB_16:
+		symbol_code = SX126X_CAD_ON_16_SYMB;
+		break;
+	case LORA_CAD_SYMB_4:
+	default:
+		/* 0 ("auto") and 4 both land here -- 4 symbols is the default. */
+		symbol_code = SX126X_CAD_ON_4_SYMB;
+		break;
+	}
+
+	det_peak = (config->cad.detection_peak != 0U)
+			   ? config->cad.detection_peak
+			   : (uint8_t)((int)config->datarate + 13);
+	det_min = (config->cad.detection_minimum != 0U)
+			  ? config->cad.detection_minimum
+			  : (uint8_t)SX126X_CAD_PARAM_DET_MIN_DEFAULT;
+
+	params[0] = symbol_code;
+	params[1] = det_peak;
+	params[2] = det_min;
+	params[3] = SX126X_CAD_GOTO_STDBY;
+	params[4] = 0U;
+	params[5] = 0U;
+	params[6] = 0U;
+
+	ret = sx126x_hal_write_cmd(dev, SX126X_CMD_SET_CAD_PARAMS, params, sizeof(params));
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = sx126x_set_dio_irq_params(
+		dev, SX126X_IRQ_CAD_DONE | SX126X_IRQ_CAD_ACTIVITY_DETECTED,
+		SX126X_IRQ_CAD_DONE | SX126X_IRQ_CAD_ACTIVITY_DETECTED, 0, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = sx126x_clear_irq_status(dev, SX126X_IRQ_ALL);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = sx126x_hal_write_cmd(dev, SX126X_CMD_SET_CAD, NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	/* Poll DIO1 directly rather than routing through the IRQ+workqueue
+	 * pipeline: CAD is a short, synchronous, blocking check that runs
+	 * inline before a TX, not an async operation needing its own
+	 * completion callback (mirrors sx126x_poll_dio1()'s direct GPIO read,
+	 * and RadioLib's own scanChannel(), a plain digitalRead() loop). */
+	deadline = k_uptime_get() + SX126X_CAD_TIMEOUT_MS;
+	while (gpio_pin_get_dt(&hal_config->dio1) == 0) {
+		if (k_uptime_get() >= deadline) {
+			ret = -ETIMEDOUT;
+			goto restore_mask;
+		}
+		k_sleep(K_USEC(200));
+	}
+
+	ret = sx126x_get_irq_status(dev, &status);
+
+restore_mask:
+	sx126x_clear_irq_status(dev, SX126X_IRQ_ALL);
+
+	/* Restore the mask sx126x_lora_config() sets, unconditionally -- the
+	 * subsequent SetTx's TX_DONE IRQ depends on it, whether CAD found the
+	 * channel busy or clear. */
+	sx126x_set_dio_irq_params(dev,
+				  SX126X_IRQ_TX_DONE | SX126X_IRQ_RX_DONE |
+					  SX126X_IRQ_RX_TX_TIMEOUT | SX126X_IRQ_CRC_ERR,
+				  SX126X_IRQ_TX_DONE | SX126X_IRQ_RX_DONE |
+					  SX126X_IRQ_RX_TX_TIMEOUT | SX126X_IRQ_CRC_ERR,
+				  0, 0);
+
+	if (ret < 0) {
+		return ret;
+	}
+
+	return (status & SX126X_IRQ_CAD_ACTIVITY_DETECTED) ? -EBUSY : 0;
+}
