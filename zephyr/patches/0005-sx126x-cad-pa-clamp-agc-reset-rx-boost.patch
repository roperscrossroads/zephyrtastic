+/*
+ * Periodic AGC reset (parity: upstream Meshtastic RadioLibInterface::resetAGC(),
+ * called every AGC_RESET_INTERVAL_MS = 60s). Empirically necessary, not
+ * theoretical: per upstream's own commit history, the SX126x's internal AGC
+ * can get stuck and RX sensitivity silently degrades -- and does not recover
+ * on its own until reboot. A plain standby cycle does not reset it; only a
+ * warm-sleep power-cycle of the analog frontend does, which is exactly what
+ * sx126x_set_sleep()/sx126x_ensure_ready() already implement (SLEEP_WARM_START
+ * retains configuration, so this is cheap -- no full recalibration).
+ *
+ * The caller (meshtastic_radio.c, on a periodic timer) is responsible for
+ * pausing continuous async RX and re-arming it afterward, exactly as it
+ * already does around a TX -- this function only does the chip-level cycle,
+ * under data->lock like every other config-touching operation in this file.
+ *
+ * Returns -EBUSY without touching the radio if a TX is in flight -- this is
+ * defense in depth; the periodic caller is expected to already serialize
+ * against TX via the same semaphore/RX-pause pattern used for sending.
+ */
+int sx126x_reset_agc(const struct device *dev)
+{
+	struct sx126x_data *data = dev->data;
+	uint8_t reg_val;
+	int ret;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+
+	if (atomic_get(&data->state) == SX126X_STATE_TX) {
+		k_mutex_unlock(&data->lock);
+		return -EBUSY;
+	}
+
+	ret = sx126x_set_sleep(dev);
+	if (ret < 0) {
+		goto out;
+	}
+
+	ret = sx126x_ensure_ready(dev);
+	if (ret < 0) {
+		goto out;
+	}
+
+	/* Re-apply the RX sensitivity patch (upstream: SPIsetRegValue(0x8B5, 0x01,
+	 * 0, 0) -- set bit 0, preserve the rest). Warned, not failed: losing this
+	 * patch is a sensitivity regression, not a reason to abandon the reset
+	 * that already succeeded. */
+	ret = sx126x_hal_read_regs(dev, SX126X_REG_RX_SENSITIVITY_PATCH, &reg_val, 1);
+	if (ret == 0) {
+		reg_val |= SX126X_RX_SENSITIVITY_PATCH_BIT;
+		ret = sx126x_hal_write_regs(dev, SX126X_REG_RX_SENSITIVITY_PATCH, &reg_val, 1);
+	}
+	if (ret < 0) {
+		LOG_WRN("AGC reset: RX sensitivity patch re-apply failed (%d)", ret);
+		ret = 0;
+	}
+
+out:
+	sx126x_set_sleep(dev);
+	k_mutex_unlock(&data->lock);
+	return ret;
+}
